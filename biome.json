{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.json", "**/*.jsonc"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*",
      "*",
      "!node_modules",
      "!bun.lock",
      "!**/.git",
      "!**/*.tgz",
      "!**/*.yml",
      "!**/*.yaml",
      "!LICENSE",
      "!**/LICENSE",
      "!**/*.png",
      "!**/*.jpg",
      "!**/*.jpeg",
      "!**/*.webp"
    ]
  },
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
